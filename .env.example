# Copy to .env and fill in. Never commit the real .env file.

# --- Core app ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-string

# --- Database / cache / storage (local docker-compose defaults) ---
DATABASE_URL="postgresql://voiceover:voiceover@localhost:5432/voiceover"
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="voiceover"
S3_SECRET_ACCESS_KEY="voiceover123"
S3_BUCKET_AUDIO="voiceover-audio"
S3_BUCKET_EXPORTS="voiceover-exports"

# --- OAuth login (not yet provisioned — see ARCHITECTURE.md) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Calendar integrations (reuse OAuth above once scoped) ---
GOOGLE_CALENDAR_REDIRECT_URI=
MICROSOFT_CALENDAR_REDIRECT_URI=

# --- Streaming ASR provider (not yet selected — see ARCHITECTURE.md section 5) ---
ASR_PROVIDER=test-double
ASR_PROVIDER_API_KEY=

# --- Meeting bot provider (e.g. Recall.ai — not yet provisioned) ---
# Empty or "test-double" = simulated bot (no real meeting is joined). Any other
# value fails API startup until that provider's adapter exists.
MEETING_BOT_PROVIDER=test-double
MEETING_BOT_PROVIDER_API_KEY=
MEETING_BOT_WEBHOOK_SECRET=

# --- LLM provider ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Stripe billing (not yet provisioned) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Slack integration ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
